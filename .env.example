# Application Settings
APP_NAME="Replit Backend for hosting AI Agents"
APP_VERSION="1.0.0"
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8080

# API Configuration
API_PREFIX=/api/v1

# External API Keys (Optional)
# Anthropic API for Claude integration
# Get your API key from: https://console.anthropic.com/settings/keys
# IMPORTANT: Use exactly this name in Replit Secrets: ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Perplexity API for LLM-powered stock data search (recommended)
# Get your API key from: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-your-api-key-here

# Alpha Vantage API for structured stock market data (primary data source)
# Get your API key from: https://www.alphavantage.co/support/#api-key
# Free tier: 25 API calls/day, 5 calls/minute
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60
