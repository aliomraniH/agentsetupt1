run = "pip install -r requirements.txt && python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080 --reload"
entrypoint = "src/core/server.py"

[nix]
channel = "stable-23_11"

[env]
PYTHONPATH = "${REPL_HOME}"
PIP_DISABLE_PIP_VERSION_CHECK = "1"

[deployment]
build = ["sh", "-c", "python -m venv /tmp/venv && /tmp/venv/bin/pip install -r requirements.txt"]
run = ["sh", "-c", "/tmp/venv/bin/python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 80
