run = "python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt && python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080 --reload"
entrypoint = "src/core/server.py"

onBoot = "python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt"

[nix]
channel = "stable-23_11"

[env]
PYTHONPATH = "${REPL_HOME}"
PIP_DISABLE_PIP_VERSION_CHECK = "1"
VIRTUAL_ENV = "${REPL_HOME}/.venv"
PATH = "${VIRTUAL_ENV}/bin:${PATH}"

[deployment]
run = ["/bin/sh", "-c", ". .venv/bin/activate && python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 80
