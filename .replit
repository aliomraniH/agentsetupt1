run = "python scripts/check_dependencies.py && python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080 --reload"
entrypoint = "src/core/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"
packages = ["libxcrypt", "xcodebuild", "zlib"]

[env]
PYTHONPATH = "${REPL_HOME}"
PIP_DISABLE_PIP_VERSION_CHECK = "1"

[deployment]
build = ["sh", "-c", "pip install --target /tmp/vendor -r requirements.txt"]
run = ["sh", "-c", "PYTHONPATH=/tmp/vendor:$PYTHONPATH python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 8080

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FastAPI Backend"

[[workflows.workflow]]
name = "FastAPI Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "source .venv/bin/activate && python -m uvicorn src.core.server:app --host 0.0.0.0 --port 8080 --reload"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
